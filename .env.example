PORT=3000

# ── Firebase ───────────────────────────────────────────────────────────────────
FIREBASE_API_KEY=your-web-api-key
FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
FIREBASE_MESSAGING_SENDER_ID=your-messaging-sender-id
FIREBASE_APP_ID=your-web-app-id
FIREBASE_MEASUREMENT_ID=your-measurement-id

# ── Gmail SMTP (Nodemailer) ────────────────────────────────────────────────────
# Step 1: Enable 2-Step Verification on your Google Account.
# Step 2: Visit https://myaccount.google.com/apppasswords
# Step 3: Create a new App Password (select "Mail" + "Windows Computer")
# Step 4: Copy the 16-character password and paste it as MAIL_PASSWORD below.
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=yourgmail@gmail.com
MAIL_PASSWORD=your_16_char_app_password
MAIL_FROM=yourgmail@gmail.com

# ── Portal URL (used in email button links) ────────────────────────────────────
# Change this to your production domain when deployed.
PORTAL_URL=http://localhost:3000
